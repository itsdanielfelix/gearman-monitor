{
  "name": "gearman-monitor",
  "version": "1.0.0",
  "description": "TUI for monitoring Gearman job servers",
  "module": "src/index.tsx",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/itsdanielfelix/gearman-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsdanielfelix/gearman-monitor"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run build.ts",
    "build:macos-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.tsx --outfile gearman-monitor-macos-arm64",
    "build:macos-x64": "bun build --compile --target=bun-darwin-x64 src/index.tsx --outfile gearman-monitor-macos-x64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.tsx --outfile gearman-monitor-linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "react": "^19.2.4"
  }
}
